{
  "name": "cast-avatar",
  "version": "1.6.0",
  "description": "Dependency-free deterministic SVG avatar generator for browsers.",
  "type": "module",
  "main": "./src/avatar.js",
  "module": "./src/avatar.js",
  "types": "./avatar.d.ts",
  "exports": {
    ".": {
      "types": "./avatar.d.ts",
      "import": "./src/avatar.js"
    },
    "./element": {
      "types": "./element.d.ts",
      "import": "./src/element.js"
    }
  },
  "sideEffects": [
    "./src/element.js"
  ],
  "files": [
    "src",
    "avatar.d.ts",
    "element.d.ts"
  ],
  "scripts": {
    "test": "node test/avatar.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "avatar",
    "svg",
    "deterministic",
    "identicon",
    "browser",
    "web-component",
    "typescript",
    "pfp",
    "profile-picture"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go4cas/cast.git"
  },
  "homepage": "https://github.com/go4cas/cast#readme",
  "bugs": {
    "url": "https://github.com/go4cas/cast/issues"
  },
  "license": "MIT"
}
